rules_version = '2';
// Fretwise: every account can read and write only its own data.
// The dictionaries (users/<uid>/dict) are written only by the Notion sync job,
// which uses a service account and is not bound by these rules. Browsers can read them, never write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/state/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/dict/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    // anything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
